---
/** Proceso de cita: tres pasos y un botón directo al canal principal (Instagram o WhatsApp). */
import { primaryContact } from '../data/site';

const steps = [
  { title: 'Cuéntanos tu idea', text: 'Qué quieres, dónde y más o menos de qué tamaño. Si tienes referencias, tráelas al chat.' },
  { title: 'Hablamos los detalles', text: 'El estudio revisa la propuesta, te pregunta lo que haga falta y te propone un diseño.' },
  { title: 'Cerramos la cita', text: 'Seguís la conversación para acordar fecha y siguientes pasos directamente con el estudio.' },
];
---

<section class="section booking" id="cita" aria-labelledby="cita-title">
  <div class="wrap">
    <p class="kicker label">Cómo pedir cita</p>
    <h2 class="h2" id="cita-title" data-reveal>Tres pasos y una conversación.</h2>

    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li data-reveal style={`--delay:${i * 0.08}s`}>
            <span class="step-num display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3"><span class="visually-hidden">Paso {i + 1}: </span>{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="cta" data-reveal>
      <a class="btn btn--primary" href={primaryContact.href} target="_blank" rel="noopener">
        Escríbenos por {primaryContact.channel}
      </a>
      <p class="muted">Las fotos de referencia las mandas directamente en el chat.</p>
    </div>
  </div>
</section>

<style>
  .booking .h2 {
    max-width: none;
    text-wrap: balance;
  }

  /* En escritorio el titular va en una sola línea horizontal */
  @media (min-width: 960px) {
    .booking .h2 {
      font-size: min(var(--step-5), 5.2vw);
      white-space: nowrap;
    }
  }

  .steps {
    display: grid;
    gap: var(--space-l);
    margin-block: var(--space-l);
  }

  .steps li {
    display: grid;
    gap: 0.6rem;
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }

  .step-num {
    font-size: var(--step-4);
    color: var(--warm);
    line-height: 0.8;
  }

  .steps p {
    max-width: 34ch;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gutter);
    }
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    padding-top: var(--space-m);
    border-top: 1px solid var(--color-border);
  }
</style>
