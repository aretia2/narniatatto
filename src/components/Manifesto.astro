---
import { featureImage } from "../data/gallery";
import Media from "./Media.astro";

const principles = [
  { title: 'Estudio de tatuajes', text: 'Diseños hechos para ti: retratos, animales, naturaleza, lettering y línea fina, en negro y gris o a color.' },
  { title: 'Galería de arte', text: 'Las paredes cambian. Exposiciones e instalaciones como el altar a Oshún, Virgen de la Caridad del Cobre.' },
  { title: 'Encuentros y guests', text: 'Conciertos acústicos, fiestas como la zambomba de diciembre y tatuadores invitados de paso por Sevilla.' },
];
---

<section class="section paper manifesto" id="nosotros" aria-labelledby="manifiesto-title">
  <div class="wrap">
    <p class="kicker label">La casa</p>

    <div class="layout">
      <div class="lead-col">
        <h2 class="h2 quote" id="manifiesto-title" data-reveal>
          Se tatúa.<br />Se expone.<br />Se celebra.
        </h2>
        <figure class="poster" data-reveal style="--delay:.1s">
          <Media image={featureImage.image} alt={featureImage.alt} aspect="2 / 3" sizes="(min-width: 960px) 24rem, 100vw" position="50% 35%" />
          <figcaption class="label">{featureImage.caption}</figcaption>
        </figure>
      </div>

      <div class="body">
        <p class="lede" data-reveal>
          Narnia es un estudio de tatuajes y una galería de arte bajo el mismo techo, en Las Candelarias. Un sitio
          para tatuarse con calma y, de paso, encontrarse con arte, música y gente.
        </p>

        <ul class="principles" role="list">
          {
            principles.map((p, i) => (
              <li data-reveal style={`--delay:${i * 0.08}s`}>
                <h3 class="h3">{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .manifesto {
    overflow: hidden;
  }

  .layout {
    display: grid;
    gap: var(--space-xl);
    position: relative;
  }

  .lead-col {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .poster {
    max-width: 22rem;
  }

  .poster :global(.media) {
    transform: rotate(-1.5deg);
    box-shadow: 0 18px 40px -20px rgb(14 13 12 / 0.45);
  }

  .poster figcaption {
    padding-top: 0.6rem;
    color: var(--warm-deep);
  }

  .body {
    display: grid;
    gap: var(--space-l);
  }

  .principles {
    display: grid;
    border-top: 1px solid var(--color-border);
  }

  .principles li {
    display: grid;
    gap: 0.4rem;
    padding-block: var(--space-m);
    border-bottom: 1px solid var(--color-border);
  }

  .principles p {
    max-width: 44ch;
    color: var(--color-muted);
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }
    .lead-col {
      grid-column: 1 / 7;
      position: sticky;
      top: calc(var(--header-h) + var(--space-l));
      align-self: start;
    }
    .body {
      grid-column: 8 / -1;
      padding-top: 1rem;
    }
  }
</style>
