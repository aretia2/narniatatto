---
import { Image } from "astro:assets";
import { primaryContact } from "../data/site";
import { logo } from "../data/gallery";
import { resolveImage } from "../lib/images";
const seal = resolveImage(logo.image);
---

<section class="final" aria-labelledby="final-title">
  <div class="wrap inner">
    {seal && <Image class="seal" src={seal} alt={logo.alt} widths={[280, 552]} sizes="(min-width: 960px) 30rem, 70vw" loading="lazy" />}
    <div class="copy">
      <h2 class="display title" id="final-title" data-reveal>¿Ya lo tienes<br />en la cabeza?</h2>
      <p class="lede" data-reveal style="--delay:.08s">Cuéntanoslo tal cual. Del resto nos encargamos juntos.</p>
      <a class="btn btn--primary" href={primaryContact.href} target="_blank" rel="noopener" data-reveal style="--delay:.14s">
        Escríbenos por {primaryContact.channel}
      </a>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    /* Halo completo, difuminado hasta el fondo sin tocar los bordes de la sección */
    background:
      radial-gradient(ellipse 42% 62% at 76% 50%, rgb(227 168 59 / 0.12), transparent 100%),
      var(--ink);
  }

  .inner {
    position: relative;
    display: grid;
    align-items: center;
  }

  .copy {
    position: relative;
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .title {
    font-size: var(--step-5);
  }

  .inner :global(.seal) {
    width: min(70vw, 20rem);
    height: auto;
    justify-self: center;
    margin-bottom: var(--space-l);
    opacity: 0.95;
  }

  @media (min-width: 960px) {
    .inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-xl);
    }
    .copy {
      grid-row: 1;
    }
    .inner :global(.seal) {
      grid-column: 2;
      grid-row: 1;
      width: clamp(18rem, 28vw, 30rem);
      margin: 0;
    }
  }
</style>
