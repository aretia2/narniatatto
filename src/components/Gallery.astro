---
import { getImage } from 'astro:assets';
import { works } from '../data/gallery';
import { site } from '../data/site';
import { resolveImage } from '../lib/images';
import Media from './Media.astro';
import Icon from './Icon.astro';

const items = await Promise.all(
  works.map(async (work) => {
    const src = resolveImage(work.image);
    const full = src ? await getImage({ src, width: Math.min(src.width, 1800), format: 'webp', quality: 82 }) : null;
    const caption = [work.title, work.artist && `por ${work.artist}`].filter(Boolean).join(', ');
    return { ...work, full, caption };
  }),
);

// Los filtros solo aparecen si hay al menos dos estilos con tres piezas cada uno.
const counts = new Map<string, number>();
works.forEach((w) => w.category && counts.set(w.category, (counts.get(w.category) ?? 0) + 1));
const categories = [...counts].filter(([, n]) => n >= 3).map(([c]) => c);
const showFilters = categories.length >= 2;
---

<section class="section gallery" id="trabajos" aria-labelledby="trabajos-title">
  <div class="wrap">
    <p class="kicker label">Trabajos</p>

    <div class="intro">
      <h2 class="h2" id="trabajos-title" data-reveal>Hecho aquí.</h2>
      <p class="lede muted" data-reveal style="--delay:.1s">
        Una selección de piezas de Danielo. El archivo completo, con lo último que sale de las máquinas,
        está en Instagram.
      </p>
    </div>

    {
      showFilters && (
        <div class="filters" role="group" aria-label="Filtrar por estilo" data-filters>
          <button type="button" class="chip" aria-pressed="true" data-filter="*">Todo</button>
          {categories.map((c) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={c}>
              {c}
            </button>
          ))}
        </div>
      )
    }

    <ul class="mosaic" role="list" data-gallery>
      {
        items.map((item, i) => (
          <li class:list={["work", item.size === "feature" && "work--feature"]} data-category={item.category ?? ""} data-reveal style={`--delay:${(i % 3) * 0.08}s`}>
            {item.full ? (
              <button
                type="button"
                class="work__open"
                data-full={item.full.src}
                data-alt={item.alt}
                data-caption={item.caption}
                aria-label={`Ampliar: ${item.alt}`}
              >
                <Media
                  image={item.image}
                  alt={item.alt}
                  aspect="4 / 5"
                  sizes={item.size === 'feature' ? '(min-width: 960px) 46vw, 100vw' : '(min-width: 960px) 23vw, 50vw'}
                  position={item.position}
                />
                {item.caption && <span class="work__tag label">{item.caption}</span>}
                <span class="work__zoom" aria-hidden="true"><Icon name="expand" /></span>
              </button>
            ) : (
              <Media image={item.image} alt={item.alt} aspect="4 / 5" sizes="(min-width: 960px) 23vw, 50vw" />
            )}
          </li>
        ))
      }
    </ul>

    <div class="more" data-reveal>
      <p class="muted">¿Buscas un estilo concreto? Pregunta y te decimos quién encaja mejor con tu idea.</p>
      <a class="btn btn--ghost" href={site.instagram.url} target="_blank" rel="noopener">
        <Icon name="instagram" /> Ver más en Instagram
      </a>
    </div>
  </div>

  <dialog class="lightbox" aria-label="Visor de trabajos" data-lightbox>
    <div class="lb__top">
      <p class="label lb__count" aria-live="polite" data-lb-count></p>
      <button type="button" class="lb__btn" data-lb-close>
        <span class="label">Cerrar</span>
        <Icon name="close" />
      </button>
    </div>
    <figure class="lb__figure">
      <img data-lb-img alt="" />
      <figcaption class="label muted" data-lb-caption></figcaption>
    </figure>
    <button type="button" class="lb__nav lb__prev" aria-label="Anterior" data-lb-prev><Icon name="prev" /></button>
    <button type="button" class="lb__nav lb__next" aria-label="Siguiente" data-lb-next><Icon name="next" /></button>
  </dialog>
</section>

<script>
  import '../scripts/gallery';
</script>

<style>
  .intro {
    display: grid;
    gap: var(--space-s) var(--space-l);
    margin-bottom: var(--space-l);
    align-items: end;
  }

  @media (min-width: 960px) {
    .intro {
      grid-template-columns: 1fr minmax(0, 26rem);
    }
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-m);
  }

  .chip {
    min-height: var(--tap);
    padding: 0.4rem 1rem;
    border: 1px solid var(--color-border);
    background: none;
    font-weight: 600;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: var(--bone);
    color: var(--ink);
    border-color: var(--bone);
  }

  /* Mosaico sin huecos: 2 columnas en móvil; en escritorio la pieza principal ocupa 2x2. */
  .mosaic {
    --gap: clamp(0.4rem, 0.25rem + 0.6vw, 0.85rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  .work[hidden] {
    display: none;
  }

  .work--feature {
    grid-column: span 2;
  }

  @media (min-width: 960px) {
    .mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .work--feature {
      grid-row: span 2;
    }
    .work--feature,
    .work--feature .work__open,
    .work--feature :global(.media) {
      height: 100%;
    }
    .work--feature :global(.media) {
      aspect-ratio: auto;
    }
  }

  .work__open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  .work__open :global(img) {
    transition: transform 0.8s var(--ease);
  }

  .work__open:hover :global(img),
  .work__open:focus-visible :global(img) {
    transform: scale(1.03);
  }

  .work__tag {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: calc(100% - 3rem);
    padding: 0.4rem 0.65rem;
    background: var(--ink);
    color: var(--bone);
    text-align: left;
  }

  .work__zoom {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--ink);
    color: var(--bone);
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .work__zoom :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .work__open:hover .work__zoom,
  .work__open:focus-visible .work__zoom {
    background: var(--accent);
    color: var(--ink);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-m);
  }

  .more .btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  /* ---- Visor ---- */

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(14 13 12 / 0.97);
    color: var(--bone);
    overscroll-behavior: contain;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto 1fr;
    animation: lb-in 0.3s var(--ease);
  }

  .lightbox::backdrop {
    background: var(--ink-veil);
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  .lb__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem var(--gutter);
    min-height: var(--header-h);
  }

  .lb__count {
    color: var(--warm);
  }

  .lb__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .lb__btn :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .lb__figure {
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    gap: 0.75rem;
    min-height: 0;
    padding: 0 var(--gutter) var(--space-m);
    touch-action: pan-y;
  }

  .lb__figure img {
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    object-fit: contain;
    align-self: center;
  }

  .lb__nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    background: rgb(14 13 12 / 0.7);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .lb__nav:hover {
    background: var(--bone);
    color: var(--ink);
  }

  .lb__nav :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .lb__prev {
    left: var(--gutter);
  }

  .lb__next {
    right: var(--gutter);
  }

  .lb__nav[hidden] {
    display: none;
  }

  @media (max-width: 639px) {
    .lb__nav {
      top: auto;
      bottom: max(1rem, env(safe-area-inset-bottom));
      transform: none;
    }
    .lb__figure {
      padding-bottom: 5rem;
    }
  }
</style>
